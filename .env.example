# Path to a local GGUF model. Leave empty to use keyword-based fallback mode.
MODEL_PATH=models/smollm2-135m-instruct-q8_0.gguf

# Use fallback for a fast local demo. Change to local_models after downloading
# the optional embedding, sentiment, and GGUF model files.
AI_MODE=fallback

# Optional: local SQLite storage. The defaults keep data inside ./data.
DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/helpdesk.db

# Zendesk is disabled unless you explicitly enable it for a dedicated test account.
ZENDESK_ENABLED=false
ZENDESK_SUBDOMAIN=
ZENDESK_EMAIL=
ZENDESK_TOKEN=

LOG_LEVEL=INFO
