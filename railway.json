{
  "$schema": "https://schema.railpack.com",
  "buildAptPackages": ["build-essential", "python3-dev", "libstdc++6", "curl"],
  "packages": {
    "python": "3.10"
  },
  "steps": {
    "build": {
      "commands": [
        "...",
        "CMAKE_ARGS=\"-DGGML_BLAS=ON -DGGML_BLAS_VENDOR=OpenBLAS\" pip install llama-cpp-python"
      ]
    }
  },
  "deploy": {
    "startCommand": "python download_model.py && uvicorn backend.main:app --host 0.0.0.0 --port ${PORT:-8000}"
  }
}